# Copy this file to .env and paste your key
OPENAI_API_KEY=sk-...

# Model that answers questions (needs to support images)
CHAT_MODEL=gpt-5.6-sol

# Model that turns audio into text (gpt-4o-mini-transcribe is cheaper)
TRANSCRIBE_MODEL=gpt-transcribe

# Seconds of audio per transcription chunk (lower = faster, more API calls)
CHUNK_SECONDS=5

# Where transcripts and summaries get saved
NOTES_DIR=~/Documents/Sidekick
