{
  "name": "sidekick",
  "productName": "Sidekick",
  "version": "2.0.1",
  "description": "Personal AI overlay: live transcription, screen reading, context-aware answers",
  "main": "main.js",
  "author": "Comfort Teke",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "install-app": "bash scripts/install.sh",
    "update": "bash scripts/update.sh"
  },
  "dependencies": {
    "dotenv": "^17.0.0",
    "marked": "^16.0.0"
  },
  "devDependencies": {
    "electron": "38.8.6",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "dev.commi.sidekick",
    "productName": "Sidekick",
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "store.js",
      "calls.js",
      "index.html",
      "styles.css",
      "assets/**",
      "!.env"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "mac": {
      "target": "dir",
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "LSUIElement": true,
        "NSMicrophoneUsageDescription": "Sidekick listens to your mic to transcribe your conversations.",
        "NSAudioCaptureUsageDescription": "Sidekick captures system audio to transcribe the other people on your calls."
      }
    }
  }
}
